# GitHub Access Token with repo read/write scopes
GITHUB_TOKEN=your_github_personal_access_token_here

# OpenAI API Key (if using OpenAI LLM Provider)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (SQLite default; postgresql://user:pass@localhost:5432/db for production)
DATABASE_URL=sqlite:///./production_agent.db

# Redis Configuration (redis://localhost:6379/0 for production)
REDIS_URL=redis://localhost:6379/0

# Production JWT & Webhook Secret Keys
JWT_SECRET=super-secret-production-jwt-key-2026
WEBHOOK_SECRET=production-webhook-secret-key-2026

# CORS & Server Settings
ALLOWED_ORIGINS=*
PORT=8000

# Configurable Workflow Settings
MODEL_NAME=gpt-4o
MAX_AGENT_ITERATIONS=10
MAX_REVISION_ATTEMPTS=3
MEMORY_ENABLED=true
TRACING_ENABLED=true
